      "interpreterVersion": 1,
      "code": "/**\n * Develops (flattens) a ruled surface into a 2D Drawing of its boundary.\n *\n * Input must be an Assembly containing a single replicad.Face — typically the\n * side face of a ruled loft. The atom samples `numRulings + 1` straight-line\n * generators across the surface (clipped to the face's trimmed outer wire),\n * then unfolds the resulting quad strip triangle-by-triangle into the plane\n * using rigid (length-preserving) edges. The returned Drawing is the closed\n * boundary of the flattened pattern, with any inner wires (holes) on the\n * source face punched out of the result.\n *\n *   rulingAxis === \"U\" / \"V\" / \"auto\" — same conventions as the rulings atom.\n *   seamAtStart === true → first ruling lies along +X in the 2D pattern;\n *                          rest of the pattern unfolds toward +Y.\n *   boundarySamples       → number of points used to approximate the trimmed\n *                          outer wire as a UV polyline. Increase if a curved\n *                          boundary (e.g. a small-radius arc) is being clipped\n *                          inaccurately; decrease for faster execution.\n *   holeSamples           → number of samples per inner wire (hole). Each hole\n *                          becomes a polygon with this many sides in the 2D\n *                          pattern; raise for smoother curves.\n *\n * If the surface is not developable at a particular strip (the four edge\n * lengths don't admit a planar quad) the atom throws an explicit error\n * naming the strip index.\n */\n// eslint-disable-next-line @typescript-eslint/no-unused-vars\nfunction run(\n  surface: Assembly,\n  numRulings: number = 24,\n  rulingAxis: string = \"auto\",\n  boundarySamples: number = 256,\n) {\n  // ── Step 1: Validate input is a single Face ───────────────────────────────\n  if (!surface || !surface.isLeaf || !surface.isLeaf()) {\n    throw new Error(\n      \"Twist heatmap: input must be an Assembly with exactly one leaf \" +\n      \"(the ruled surface as a replicad.Face).\",\n    );\n  }\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  const face = surface.geometry as any;\n  if (!(face instanceof replicad.Face)) {\n    throw new Error(\n      \"Twist heatmap: input geometry must be a replicad.Face from a ruled \" +\n      \"loft; got \" +\n      (face && face.constructor ? face.constructor.name : typeof face),\n    );\n  }\n  if (!Number.isFinite(numRulings) || numRulings < 1) {\n    throw new Error(\"Twist heatmap: numRulings must be a positive integer.\");\n  }\n  if (!Number.isFinite(boundarySamples) || boundarySamples < 8) {\n    throw new Error(\n      \"Twist heatmap: boundarySamples must be an integer ≥ 8 (used to \" +\n      \"approximate the trimmed outer wire as a UV polyline).\",\n    );\n  }\n  const n = Math.max(1, Math.floor(numRulings));\n  const boundaryN = Math.max(8, Math.floor(boundarySamples));\n\n  const { uMin, uMax, vMin, vMax } = face.UVBounds;\n\n  type T3 = [number, number, number];\n  type T2 = [number, number];\n\n  // IMPORTANT: replicad's face.pointOnSurface(u, v) takes NORMALISED\n  // parameters in [0, 1] (internally it computes uMin + u*(uMax-uMin)), while\n  // face.UVBounds and face.uvCoordinates(...) return ABSOLUTE OCCT parameter\n  // values. We use absolute params everywhere outside this helper so the\n  // clipping math stays consistent with uvCoordinates() output, and convert\n  // to normalised here at the actual call to pointOnSurface.\n  const uSpan = uMax - uMin;\n  const vSpan = vMax - vMin;\n  const sampleTuple = (uAbs: number, vAbs: number): T3 => {\n    const uN = uSpan === 0 ? 0 : (uAbs - uMin) / uSpan;\n    const vN = vSpan === 0 ? 0 : (vAbs - vMin) / vSpan;\n    const p = face.pointOnSurface(uN, vN);\n    return [p.x, p.y, p.z];\n  };\n\n  // ── Step 2: Auto-detect / validate the ruling axis ───────────────────────\n  // Same heuristic as the rulings atom: an iso-curve is \"straight\" when the\n  // midpoint sag is negligible relative to the chord length.\n  const STRAIGHT_TOL = 1e-4;\n  const isStraightAlong = (which: \"U\" | \"V\"): boolean => {\n    const cross =\n      which === \"U\" ? vMin + 0.5 * (vMax - vMin) : uMin + 0.5 * (uMax - uMin);\n    const a = which === \"U\" ? uMin : vMin;\n    const b = which === \"U\" ? uMax : vMax;\n    const get = (t: number) =>\n      which === \"U\" ? sampleTuple(t, cross) : sampleTuple(cross, t);\n    const p0 = get(a);\n    const pm = get(0.5 * (a + b));\n    const p1 = get(b);\n    const dx = p1[0] - p0[0],\n      dy = p1[1] - p0[1],\n      dz = p1[2] - p0[2];\n    const chord = Math.hypot(dx, dy, dz);\n    if (chord === 0) return false;\n    const tx = pm[0] - p0[0],\n      ty = pm[1] - p0[1],\n      tz = pm[2] - p0[2];\n    const cx = dy * tz - dz * ty;\n    const cy = dz * tx - dx * tz;\n    const cz = dx * ty - dy * tx;\n    const perp = Math.hypot(cx, cy, cz) / chord;\n    return perp / chord < STRAIGHT_TOL;\n  };\n\n  let axis: \"U\" | \"V\";\n  if (rulingAxis === \"U\" || rulingAxis === \"V\") {\n    axis = rulingAxis;\n  } else if (rulingAxis === \"auto\") {\n    if (isStraightAlong(\"V\")) axis = \"V\";\n    else if (isStraightAlong(\"U\")) axis = \"U\";\n    else\n      throw new Error(\n        \"Develop surface: auto-detect failed — surface is not straight along \" +\n        \"either parametric axis. Override with rulingAxis: 'U' or 'V'.\",\n      );\n  } else {\n    throw new Error(\n      'Develop surface: rulingAxis must be \"auto\", \"U\", or \"V\"; got ' +\n      JSON.stringify(rulingAxis),\n    );\n  }\n\n  // ── Step 3: Sample the trimmed boundary in UV space ──────────────────────\n  // face.pointOnSurface() walks the underlying parametric surface, which can\n  // extend well beyond the actual trimmed face — e.g. a conical loft's\n  // underlying surface continues toward its apex below the bottom circle.\n  // We follow face.outerWire() in UV space and use it to clip each ruling to\n  // the trimmed region.\n  const outerWire = face.clone().outerWire();\n  const uvBoundary: T2[] = [];\n  for (let i = 0; i < boundaryN; i++) {\n    const t = i / boundaryN;\n    const p3d = outerWire.pointAt(t);\n    const uv = face.uvCoordinates(p3d);\n    uvBoundary.push([uv[0], uv[1]]);\n  }\n\n  // Indices into a [u, v] tuple for the cross-axis (perpendicular to rulings)\n  // vs the along-axis (parallel to rulings).\n  //   axis === \"V\": rulings sweep V; cross-axis is U  → crossIdx=0, alongIdx=1\n  //   axis === \"U\": rulings sweep U; cross-axis is V  → crossIdx=1, alongIdx=0\n  const crossIdx = axis === \"V\" ? 0 : 1;\n  const alongIdx = 1 - crossIdx;\n\n  // Actual cross-axis extent of the trimmed boundary.\n  let crossMinActual = Infinity;\n  let crossMaxActual = -Infinity;\n  for (const uv of uvBoundary) {\n    if (uv[crossIdx] < crossMinActual) crossMinActual = uv[crossIdx];\n    if (uv[crossIdx] > crossMaxActual) crossMaxActual = uv[crossIdx];\n  }\n  const crossSpan = crossMaxActual - crossMinActual;\n  if (!(crossSpan > 0)) {\n    throw new Error(\n      \"Develop surface: trimmed boundary has zero extent on the cross-axis.\",\n    );\n  }\n\n  // Intersect the iso-line \"cross-axis = crossParam\" with the closed UV\n  // polyline and return [alongMin, alongMax] — the actual along-axis extent\n  // of the trimmed face at that cross-axis value.\n  const rulingRange = (crossParam: number): [number, number] => {\n    const hits: number[] = [];\n    const N = uvBoundary.length;\n    for (let j = 0; j < N; j++) {\n      const a = uvBoundary[j];\n      const b = uvBoundary[(j + 1) % N];\n      const aC = a[crossIdx];\n      const bC = b[crossIdx];\n      if (aC === bC) continue;\n      // Skip seam wraparounds on periodic surfaces: a segment that jumps\n      // more than half the cross-axis span is almost certainly the U=0 ↔ U=2π\n      // discontinuity, not a real boundary edge.\n      if (Math.abs(bC - aC) > 0.5 * crossSpan) continue;\n      // Half-open straddle so a vertex lying exactly on the iso-line is\n      // counted by exactly one of its two incident segments.\n      const straddles =\n        (aC <= crossParam && bC > crossParam) ||\n        (bC <= crossParam && aC > crossParam);\n      if (!straddles) continue;\n      const t = (crossParam - aC) / (bC - aC);\n      hits.push(a[alongIdx] + t * (b[alongIdx] - a[alongIdx]));\n    }\n    if (hits.length < 2) {\n      throw new Error(\n        `Develop surface: cross-axis ${axis === \"V\" ? \"U\" : \"V\"}=` +\n        `${crossParam.toFixed(4)} intersects the outer wire at ` +\n        `${hits.length} point(s) (expected ≥2). The boundary may be ` +\n        `degenerate at this parameter, or boundarySamples may be too low ` +\n        `to resolve it.`,\n      );\n    }\n    hits.sort((a, b) => a - b);\n    return [hits[0], hits[hits.length - 1]];\n  };\n\n  // ── Step 4: Sample the two 3D rails using clipped iso-line ranges ────────\n  const railA: T3[] = [];\n  const railB: T3[] = [];\n  for (let i = 0; i <= n; i++) {\n    const t = i / n;\n    let crossParam = crossMinActual + t * crossSpan;\n    // Nudge the very first and last samples a hair inward so the iso-line\n    // genuinely crosses the boundary polygon (it may be tangent at the\n    // extreme cross-axis values, giving <2 hits otherwise).\n    if (i === 0) crossParam += crossSpan * 1e-6;\n    if (i === n) crossParam -= crossSpan * 1e-6;\n    const [alongLow, alongHigh] = rulingRange(crossParam);\n    const aU = axis === \"V\" ? crossParam : alongLow;\n    const aV = axis === \"V\" ? alongLow : crossParam;\n    const bU = axis === \"V\" ? crossParam : alongHigh;\n    const bV = axis === \"V\" ? alongHigh : crossParam;\n    railA.push(sampleTuple(aU, aV));\n    railB.push(sampleTuple(bU, bV));\n  }\n\n  const dist3 = (p: T3, q: T3) =>\n    Math.hypot(p[0] - q[0], p[1] - q[1], p[2] - q[2]);\n\n  // ── Step 5: Per-quad twist (geometric non-planarity) ──────────────────\n  // For each quad (railA[i], railA[i+1], railB[i+1], railB[i]) measure the\n  // perpendicular distance from corner B[i] to the plane of (A[i], A[i+1],\n  // B[i+1]), normalised by mean edge length. Equivalently 3·V_tet /\n  // area(A,Ap,Bp) / avgEdge from the scalar triple product. Exactly zero\n  // for any planar quad (cone strips report 0 regardless of ruling count);\n  // grows with intrinsic surface curvature.\n  const twistPerQuad: number[] = new Array(n);\n  let twistMax = 0;\n  let twistSumSq = 0;\n  for (let i = 0; i < n; i++) {\n    const A = railA[i];\n    const Ap = railA[i + 1];\n    const B = railB[i];\n    const Bp = railB[i + 1];\n    const e1x = Ap[0] - A[0],\n      e1y = Ap[1] - A[1],\n      e1z = Ap[2] - A[2];\n    const e2x = Bp[0] - A[0],\n      e2y = Bp[1] - A[1],\n      e2z = Bp[2] - A[2];\n    const e3x = B[0] - A[0],\n      e3y = B[1] - A[1],\n      e3z = B[2] - A[2];\n    const nx = e1y * e2z - e1z * e2y;\n    const ny = e1z * e2x - e1x * e2z;\n    const nz = e1x * e2y - e1y * e2x;\n    const nMag = Math.hypot(nx, ny, nz);\n    const height =\n      nMag > 0 ? Math.abs(nx * e3x + ny * e3y + nz * e3z) / nMag : 0;\n    const avgEdge =\n      0.25 * (dist3(A, Ap) + dist3(Ap, Bp) + dist3(Bp, B) + dist3(B, A));\n    const twist = avgEdge > 0 ? height / avgEdge : 0;\n    twistPerQuad[i] = twist;\n    if (twist > twistMax) twistMax = twist;\n    twistSumSq += twist * twist;\n  }\n  const twistRMS = Math.sqrt(twistSumSq / n);\n  const verdict =\n    twistMax < 1e-3\n      ? \"DEVELOPABLE\"\n      : twistMax < 1e-2\n        ? \"NEARLY DEVELOPABLE\"\n        : \"NON-DEVELOPABLE\";\n  console.log(\n    `Twist heatmap: ${n} strip${n === 1 ? \"\" : \"s\"}, axis=${axis}\\n` +\n    `  max non-planarity ${twistMax.toExponential(2)} | ` +\n    `RMS ${twistRMS.toExponential(2)}  →  ${verdict}`,\n  );\n\n  return new Assembly({\n    geometry: face,\n    color: \"#5B9BD5\",\n    tags: [\"heatmap:twist\", \"ruling-axis:\" + axis],\n    metadata: {\n      meshOverride: buildHeatmapMeshOverride(\n        face,\n        twistPerQuad,\n        crossMinActual,\n        crossSpan,\n        crossIdx,\n        n,\n      ),\n    },\n  });\n}\n\n// ─── meshOverride baking ──────────────────────────────────────────────────\n//\n// Colour the face's own OCCT tessellation by strip twist. Every mesh vertex\n// is mapped back to its UV with face.uvCoordinates, bucketed into one of\n// the n strips along the cross-axis, and painted with that strip's gradient\n// colour. Reusing the face's existing mesh keeps the rendered surface\n// indistinguishable from a plain face render while embedding the heatmap;\n// no upsampling or per-quad re-triangulation needed.\n//\n// Triangles whose three vertices straddle a strip boundary will show a\n// short colour gradient via GPU interpolation. For a continuous quality\n// metric this reads as a soft strip-to-strip transition rather than as\n// noise, and there's nothing to subdivide away.\n\nfunction buildHeatmapMeshOverride(\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  face: any,\n  twistPerQuad: number[],\n  crossMinActual: number,\n  crossSpan: number,\n  crossIdx: number,\n  n: number,\n) {\n  const faces = face.mesh({ tolerance: 0.1, angularTolerance: 0.5 });\n  const edges = face.meshEdges({ tolerance: 0.1, angularTolerance: 0.5 });\n\n  const [r0, g0, b0] = hexToRgb(\"#ffffff\");\n  const [r1, g1, b1] = hexToRgb(\"#ff0000\");\n  const rmin = 0;\n  const rspan = 0.01;\n\n  const numVerts = faces.vertices.length / 3;\n  const vertexColors: number[] = new Array(numVerts * 3);\n  for (let v = 0; v < numVerts; v++) {\n    const px = faces.vertices[v * 3];\n    const py = faces.vertices[v * 3 + 1];\n    const pz = faces.vertices[v * 3 + 2];\n    let stripIdx = 0;\n    try {\n      const uv = face.uvCoordinates([px, py, pz] as [number, number, number]);\n      const c = uv[crossIdx];\n      stripIdx = Math.floor(((c - crossMinActual) * n) / crossSpan);\n      if (stripIdx < 0) stripIdx = 0;\n      else if (stripIdx > n - 1) stripIdx = n - 1;\n    } catch {\n      // UV lookup can fail on seam/boundary vertices; fall back to strip 0.\n    }\n    let s = (twistPerQuad[stripIdx] - rmin) / rspan;\n    if (s < 0) s = 0;\n    else if (s > 1) s = 1;\n    vertexColors[v * 3] = r0 + (r1 - r0) * s;\n    vertexColors[v * 3 + 1] = g0 + (g1 - g0) * s;\n    vertexColors[v * 3 + 2] = b0 + (b1 - b0) * s;\n  }\n\n  return {\n    faces,\n    edges,\n    // Plain array (not Float32Array) so metadata.meshOverride survives the\n    // JSON round-trip in cacheAssemblyStructure/getAssembly. Renderer wraps\n    // back into a typed array when constructing the BufferAttribute.\n    vertexColors,\n  };\n}\n\nfunction hexToRgb(hex: string): [number, number, number] {\n  const h = hex.replace(\"#\", \"\");\n  return [\n    parseInt(h.slice(0, 2), 16) / 255,\n    parseInt(h.slice(2, 4), 16) / 255,\n    parseInt(h.slice(4, 6), 16) / 255,\n  ];\n}\n",
      "compiledCode": "\"use strict\";\n/**\n * Develops (flattens) a ruled surface into a 2D Drawing of its boundary.\n *\n * Input must be an Assembly containing a single replicad.Face — typically the\n * side face of a ruled loft. The atom samples `numRulings + 1` straight-line\n * generators across the surface (clipped to the face's trimmed outer wire),\n * then unfolds the resulting quad strip triangle-by-triangle into the plane\n * using rigid (length-preserving) edges. The returned Drawing is the closed\n * boundary of the flattened pattern, with any inner wires (holes) on the\n * source face punched out of the result.\n *\n *   rulingAxis === \"U\" / \"V\" / \"auto\" — same conventions as the rulings atom.\n *   seamAtStart === true → first ruling lies along +X in the 2D pattern;\n *                          rest of the pattern unfolds toward +Y.\n *   boundarySamples       → number of points used to approximate the trimmed\n *                          outer wire as a UV polyline. Increase if a curved\n *                          boundary (e.g. a small-radius arc) is being clipped\n *                          inaccurately; decrease for faster execution.\n *   holeSamples           → number of samples per inner wire (hole). Each hole\n *                          becomes a polygon with this many sides in the 2D\n *                          pattern; raise for smoother curves.\n *\n * If the surface is not developable at a particular strip (the four edge\n * lengths don't admit a planar quad) the atom throws an explicit error\n * naming the strip index.\n */\n// eslint-disable-next-line @typescript-eslint/no-unused-vars\nfunction run(surface, numRulings = 24, rulingAxis = \"auto\", boundarySamples = 256) {\n    // ── Step 1: Validate input is a single Face ───────────────────────────────\n    if (!surface || !surface.isLeaf || !surface.isLeaf()) {\n        throw new Error(\"Twist heatmap: input must be an Assembly with exactly one leaf \" +\n            \"(the ruled surface as a replicad.Face).\");\n    }\n    // eslint-disable-next-line @typescript-eslint/no-explicit-any\n    const face = surface.geometry;\n    if (!(face instanceof replicad.Face)) {\n        throw new Error(\"Twist heatmap: input geometry must be a replicad.Face from a ruled \" +\n            \"loft; got \" +\n            (face && face.constructor ? face.constructor.name : typeof face));\n    }\n    if (!Number.isFinite(numRulings) || numRulings < 1) {\n        throw new Error(\"Twist heatmap: numRulings must be a positive integer.\");\n    }\n    if (!Number.isFinite(boundarySamples) || boundarySamples < 8) {\n        throw new Error(\"Twist heatmap: boundarySamples must be an integer ≥ 8 (used to \" +\n            \"approximate the trimmed outer wire as a UV polyline).\");\n    }\n    const n = Math.max(1, Math.floor(numRulings));\n    const boundaryN = Math.max(8, Math.floor(boundarySamples));\n    const { uMin, uMax, vMin, vMax } = face.UVBounds;\n    // IMPORTANT: replicad's face.pointOnSurface(u, v) takes NORMALISED\n    // parameters in [0, 1] (internally it computes uMin + u*(uMax-uMin)), while\n    // face.UVBounds and face.uvCoordinates(...) return ABSOLUTE OCCT parameter\n    // values. We use absolute params everywhere outside this helper so the\n    // clipping math stays consistent with uvCoordinates() output, and convert\n    // to normalised here at the actual call to pointOnSurface.\n    const uSpan = uMax - uMin;\n    const vSpan = vMax - vMin;\n    const sampleTuple = (uAbs, vAbs) => {\n        const uN = uSpan === 0 ? 0 : (uAbs - uMin) / uSpan;\n        const vN = vSpan === 0 ? 0 : (vAbs - vMin) / vSpan;\n        const p = face.pointOnSurface(uN, vN);\n        return [p.x, p.y, p.z];\n    };\n    // ── Step 2: Auto-detect / validate the ruling axis ───────────────────────\n    // Same heuristic as the rulings atom: an iso-curve is \"straight\" when the\n    // midpoint sag is negligible relative to the chord length.\n    const STRAIGHT_TOL = 1e-4;\n    const isStraightAlong = (which) => {\n        const cross = which === \"U\" ? vMin + 0.5 * (vMax - vMin) : uMin + 0.5 * (uMax - uMin);\n        const a = which === \"U\" ? uMin : vMin;\n        const b = which === \"U\" ? uMax : vMax;\n        const get = (t) => which === \"U\" ? sampleTuple(t, cross) : sampleTuple(cross, t);\n        const p0 = get(a);\n        const pm = get(0.5 * (a + b));\n        const p1 = get(b);\n        const dx = p1[0] - p0[0], dy = p1[1] - p0[1], dz = p1[2] - p0[2];\n        const chord = Math.hypot(dx, dy, dz);\n        if (chord === 0)\n            return false;\n        const tx = pm[0] - p0[0], ty = pm[1] - p0[1], tz = pm[2] - p0[2];\n        const cx = dy * tz - dz * ty;\n        const cy = dz * tx - dx * tz;\n        const cz = dx * ty - dy * tx;\n        const perp = Math.hypot(cx, cy, cz) / chord;\n        return perp / chord < STRAIGHT_TOL;\n    };\n    let axis;\n    if (rulingAxis === \"U\" || rulingAxis === \"V\") {\n        axis = rulingAxis;\n    }\n    else if (rulingAxis === \"auto\") {\n        if (isStraightAlong(\"V\"))\n            axis = \"V\";\n        else if (isStraightAlong(\"U\"))\n            axis = \"U\";\n        else\n            throw new Error(\"Develop surface: auto-detect failed — surface is not straight along \" +\n                \"either parametric axis. Override with rulingAxis: 'U' or 'V'.\");\n    }\n    else {\n        throw new Error('Develop surface: rulingAxis must be \"auto\", \"U\", or \"V\"; got ' +\n            JSON.stringify(rulingAxis));\n    }\n    // ── Step 3: Sample the trimmed boundary in UV space ──────────────────────\n    // face.pointOnSurface() walks the underlying parametric surface, which can\n    // extend well beyond the actual trimmed face — e.g. a conical loft's\n    // underlying surface continues toward its apex below the bottom circle.\n    // We follow face.outerWire() in UV space and use it to clip each ruling to\n    // the trimmed region.\n    const outerWire = face.clone().outerWire();\n    const uvBoundary = [];\n    for (let i = 0; i < boundaryN; i++) {\n        const t = i / boundaryN;\n        const p3d = outerWire.pointAt(t);\n        const uv = face.uvCoordinates(p3d);\n        uvBoundary.push([uv[0], uv[1]]);\n    }\n    // Indices into a [u, v] tuple for the cross-axis (perpendicular to rulings)\n    // vs the along-axis (parallel to rulings).\n    //   axis === \"V\": rulings sweep V; cross-axis is U  → crossIdx=0, alongIdx=1\n    //   axis === \"U\": rulings sweep U; cross-axis is V  → crossIdx=1, alongIdx=0\n    const crossIdx = axis === \"V\" ? 0 : 1;\n    const alongIdx = 1 - crossIdx;\n    // Actual cross-axis extent of the trimmed boundary.\n    let crossMinActual = Infinity;\n    let crossMaxActual = -Infinity;\n    for (const uv of uvBoundary) {\n        if (uv[crossIdx] < crossMinActual)\n            crossMinActual = uv[crossIdx];\n        if (uv[crossIdx] > crossMaxActual)\n            crossMaxActual = uv[crossIdx];\n    }\n    const crossSpan = crossMaxActual - crossMinActual;\n    if (!(crossSpan > 0)) {\n        throw new Error(\"Develop surface: trimmed boundary has zero extent on the cross-axis.\");\n    }\n    // Intersect the iso-line \"cross-axis = crossParam\" with the closed UV\n    // polyline and return [alongMin, alongMax] — the actual along-axis extent\n    // of the trimmed face at that cross-axis value.\n    const rulingRange = (crossParam) => {\n        const hits = [];\n        const N = uvBoundary.length;\n        for (let j = 0; j < N; j++) {\n            const a = uvBoundary[j];\n            const b = uvBoundary[(j + 1) % N];\n            const aC = a[crossIdx];\n            const bC = b[crossIdx];\n            if (aC === bC)\n                continue;\n            // Skip seam wraparounds on periodic surfaces: a segment that jumps\n            // more than half the cross-axis span is almost certainly the U=0 ↔ U=2π\n            // discontinuity, not a real boundary edge.\n            if (Math.abs(bC - aC) > 0.5 * crossSpan)\n                continue;\n            // Half-open straddle so a vertex lying exactly on the iso-line is\n            // counted by exactly one of its two incident segments.\n            const straddles = (aC <= crossParam && bC > crossParam) ||\n                (bC <= crossParam && aC > crossParam);\n            if (!straddles)\n                continue;\n            const t = (crossParam - aC) / (bC - aC);\n            hits.push(a[alongIdx] + t * (b[alongIdx] - a[alongIdx]));\n        }\n        if (hits.length < 2) {\n            throw new Error(`Develop surface: cross-axis ${axis === \"V\" ? \"U\" : \"V\"}=` +\n                `${crossParam.toFixed(4)} intersects the outer wire at ` +\n                `${hits.length} point(s) (expected ≥2). The boundary may be ` +\n                `degenerate at this parameter, or boundarySamples may be too low ` +\n                `to resolve it.`);\n        }\n        hits.sort((a, b) => a - b);\n        return [hits[0], hits[hits.length - 1]];\n    };\n    // ── Step 4: Sample the two 3D rails using clipped iso-line ranges ────────\n    const railA = [];\n    const railB = [];\n    for (let i = 0; i <= n; i++) {\n        const t = i / n;\n        let crossParam = crossMinActual + t * crossSpan;\n        // Nudge the very first and last samples a hair inward so the iso-line\n        // genuinely crosses the boundary polygon (it may be tangent at the\n        // extreme cross-axis values, giving <2 hits otherwise).\n        if (i === 0)\n            crossParam += crossSpan * 1e-6;\n        if (i === n)\n            crossParam -= crossSpan * 1e-6;\n        const [alongLow, alongHigh] = rulingRange(crossParam);\n        const aU = axis === \"V\" ? crossParam : alongLow;\n        const aV = axis === \"V\" ? alongLow : crossParam;\n        const bU = axis === \"V\" ? crossParam : alongHigh;\n        const bV = axis === \"V\" ? alongHigh : crossParam;\n        railA.push(sampleTuple(aU, aV));\n        railB.push(sampleTuple(bU, bV));\n    }\n    const dist3 = (p, q) => Math.hypot(p[0] - q[0], p[1] - q[1], p[2] - q[2]);\n    // ── Step 5: Per-quad twist (geometric non-planarity) ──────────────────\n    // For each quad (railA[i], railA[i+1], railB[i+1], railB[i]) measure the\n    // perpendicular distance from corner B[i] to the plane of (A[i], A[i+1],\n    // B[i+1]), normalised by mean edge length. Equivalently 3·V_tet /\n    // area(A,Ap,Bp) / avgEdge from the scalar triple product. Exactly zero\n    // for any planar quad (cone strips report 0 regardless of ruling count);\n    // grows with intrinsic surface curvature.\n    const twistPerQuad = new Array(n);\n    let twistMax = 0;\n    let twistSumSq = 0;\n    for (let i = 0; i < n; i++) {\n        const A = railA[i];\n        const Ap = railA[i + 1];\n        const B = railB[i];\n        const Bp = railB[i + 1];\n        const e1x = Ap[0] - A[0], e1y = Ap[1] - A[1], e1z = Ap[2] - A[2];\n        const e2x = Bp[0] - A[0], e2y = Bp[1] - A[1], e2z = Bp[2] - A[2];\n        const e3x = B[0] - A[0], e3y = B[1] - A[1], e3z = B[2] - A[2];\n        const nx = e1y * e2z - e1z * e2y;\n        const ny = e1z * e2x - e1x * e2z;\n        const nz = e1x * e2y - e1y * e2x;\n        const nMag = Math.hypot(nx, ny, nz);\n        const height = nMag > 0 ? Math.abs(nx * e3x + ny * e3y + nz * e3z) / nMag : 0;\n        const avgEdge = 0.25 * (dist3(A, Ap) + dist3(Ap, Bp) + dist3(Bp, B) + dist3(B, A));\n        const twist = avgEdge > 0 ? height / avgEdge : 0;\n        twistPerQuad[i] = twist;\n        if (twist > twistMax)\n            twistMax = twist;\n        twistSumSq += twist * twist;\n    }\n    const twistRMS = Math.sqrt(twistSumSq / n);\n    const verdict = twistMax < 1e-3\n        ? \"DEVELOPABLE\"\n        : twistMax < 1e-2\n            ? \"NEARLY DEVELOPABLE\"\n            : \"NON-DEVELOPABLE\";\n    console.log(`Twist heatmap: ${n} strip${n === 1 ? \"\" : \"s\"}, axis=${axis}\\n` +\n        `  max non-planarity ${twistMax.toExponential(2)} | ` +\n        `RMS ${twistRMS.toExponential(2)}  →  ${verdict}`);\n    return new Assembly({\n        geometry: face,\n        color: \"#5B9BD5\",\n        tags: [\"heatmap:twist\", \"ruling-axis:\" + axis],\n        metadata: {\n            meshOverride: buildHeatmapMeshOverride(face, twistPerQuad, crossMinActual, crossSpan, crossIdx, n),\n        },\n    });\n}\n// ─── meshOverride baking ──────────────────────────────────────────────────\n//\n// Colour the face's own OCCT tessellation by strip twist. Every mesh vertex\n// is mapped back to its UV with face.uvCoordinates, bucketed into one of\n// the n strips along the cross-axis, and painted with that strip's gradient\n// colour. Reusing the face's existing mesh keeps the rendered surface\n// indistinguishable from a plain face render while embedding the heatmap;\n// no upsampling or per-quad re-triangulation needed.\n//\n// Triangles whose three vertices straddle a strip boundary will show a\n// short colour gradient via GPU interpolation. For a continuous quality\n// metric this reads as a soft strip-to-strip transition rather than as\n// noise, and there's nothing to subdivide away.\nfunction buildHeatmapMeshOverride(\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\nface, twistPerQuad, crossMinActual, crossSpan, crossIdx, n) {\n    const faces = face.mesh({ tolerance: 0.1, angularTolerance: 0.5 });\n    const edges = face.meshEdges({ tolerance: 0.1, angularTolerance: 0.5 });\n    const [r0, g0, b0] = hexToRgb(\"#ffffff\");\n    const [r1, g1, b1] = hexToRgb(\"#ff0000\");\n    const rmin = 0;\n    const rspan = 0.01;\n    const numVerts = faces.vertices.length / 3;\n    const vertexColors = new Array(numVerts * 3);\n    for (let v = 0; v < numVerts; v++) {\n        const px = faces.vertices[v * 3];\n        const py = faces.vertices[v * 3 + 1];\n        const pz = faces.vertices[v * 3 + 2];\n        let stripIdx = 0;\n        try {\n            const uv = face.uvCoordinates([px, py, pz]);\n            const c = uv[crossIdx];\n            stripIdx = Math.floor(((c - crossMinActual) * n) / crossSpan);\n            if (stripIdx < 0)\n                stripIdx = 0;\n            else if (stripIdx > n - 1)\n                stripIdx = n - 1;\n        }\n        catch {\n            // UV lookup can fail on seam/boundary vertices; fall back to strip 0.\n        }\n        let s = (twistPerQuad[stripIdx] - rmin) / rspan;\n        if (s < 0)\n            s = 0;\n        else if (s > 1)\n            s = 1;\n        vertexColors[v * 3] = r0 + (r1 - r0) * s;\n        vertexColors[v * 3 + 1] = g0 + (g1 - g0) * s;\n        vertexColors[v * 3 + 2] = b0 + (b1 - b0) * s;\n    }\n    return {\n        faces,\n        edges,\n        // Plain array (not Float32Array) so metadata.meshOverride survives the\n        // JSON round-trip in cacheAssemblyStructure/getAssembly. Renderer wraps\n        // back into a typed array when constructing the BufferAttribute.\n        vertexColors,\n    };\n}\nfunction hexToRgb(hex) {\n    const h = hex.replace(\"#\", \"\");\n    return [\n        parseInt(h.slice(0, 2), 16) / 255,\n        parseInt(h.slice(2, 4), 16) / 255,\n        parseInt(h.slice(4, 6), 16) / 255,\n    ];\n}\n"
    },
